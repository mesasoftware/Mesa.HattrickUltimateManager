<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Mesa.HUM.UI.Desktop.App"
             xmlns:local="using:Mesa.HUM.UI.Desktop"
             xmlns:styling="using:FluentAvalonia.Styling"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>

        <local:ViewLocator/>

    </Application.DataTemplates>

    <Application.Styles>

        <!-- Icons -->
        <StyleInclude Source="/Assets/Svg/Icons.axaml" />
        <StyleInclude Source="/Assets/Svg/Buttons.axaml" />

        <!-- Styles -->
        <StyleInclude Source="/Assets/Styles/Common.axaml" />

        <styling:FluentAvaloniaTheme />

    </Application.Styles>

    <Application.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <ResourceInclude Source="/Views/Components/CustomButton.axaml" />

            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>

    </Application.Resources>

</Application>