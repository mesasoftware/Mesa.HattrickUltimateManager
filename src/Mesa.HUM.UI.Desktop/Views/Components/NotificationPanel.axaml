<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:contracts="using:Mesa.HUM.Presentation.Stores.Contracts"
             xmlns:conv="using:Mesa.HUM.UI.Desktop.Converters"
             xmlns:stores="using:Mesa.HUM.Presentation.Stores.Interfaces"
             mc:Ignorable="d"
             d:DesignWidth="360"
             d:DesignHeight="200"
             x:Class="Mesa.HUM.UI.Desktop.Views.Components.NotificationPanel"
             x:DataType="stores:INotificationStore">

    <UserControl.Resources>

        <conv:NotificationSeverityToBackgroundBrushConverter x:Key="notificationSeverityToBackgroundBrushConverter" />
        <conv:NotificationSeverityToBorderBrushConverter x:Key="notificationSeverityToBorderBrushConverter" />
        <conv:NotificationSeverityToIconConverter x:Key="notificationSeverityToIconConverter" />

    </UserControl.Resources>

    <!-- Notification overlay -->
    <ItemsControl
        HorizontalAlignment="Right"
        ItemsSource="{Binding Notifications}"
        Margin="16"
        MaxWidth="500"
        VerticalAlignment="Bottom">

        <ItemsControl.ItemsPanel>

            <ItemsPanelTemplate>

                <StackPanel
                    Orientation="Vertical"
                    Spacing="5" />

            </ItemsPanelTemplate>

        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>

            <DataTemplate x:DataType="contracts:NotificationModel">

                <Border
                    Background="{Binding Severity, Converter={StaticResource notificationSeverityToBackgroundBrushConverter}}"
                    BorderBrush="{Binding Severity, Converter={StaticResource notificationSeverityToBorderBrushConverter}}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0">

                    <Grid ColumnDefinitions="Auto,*,Auto">

                        <PathIcon
                            Grid.Column="0"
                            Data="{Binding Severity, Converter={StaticResource notificationSeverityToIconConverter}}"
                            Foreground="{DynamicResource TextFillColorPrimary}"
                            Height="20"
                            Width="20"
                            VerticalAlignment="Center"
                            Margin="0 0 12 0" />

                        <TextBlock
                            Grid.Column="1"
                            Foreground="{DynamicResource TextFillColorPrimary}"
                            Text="{Binding Message}"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center" />

                        <Button
                            Grid.Column="2"
                            Background="Transparent"
                            Command="{Binding $parent[ItemsControl].((stores:INotificationStore)DataContext).DismissCommand}"
                            CommandParameter="{Binding}"
                            Content="✕"
                            FontSize="10"
                            Padding="4 2"
                            Margin="8 0 0 0" />

                    </Grid>

                </Border>

            </DataTemplate>

        </ItemsControl.ItemTemplate>

    </ItemsControl>

</UserControl>
