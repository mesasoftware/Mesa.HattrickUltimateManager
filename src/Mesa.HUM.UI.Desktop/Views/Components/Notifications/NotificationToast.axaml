<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:contracts="using:Mesa.HUM.Presentation.Stores.Contracts"
             xmlns:conv="using:Mesa.HUM.UI.Desktop.Converters"
             xmlns:vm="using:Mesa.HUM.Presentation.ViewModels.Components.Notifications"
             mc:Ignorable="d"
             d:DesignWidth="500"
             d:DesignHeight="200"
             x:Class="Mesa.HUM.UI.Desktop.Views.Components.Notifications.NotificationToast"
             x:DataType="contracts:NotificationModel">

    <UserControl.Resources>

        <conv:NotificationSeverityToBackgroundBrushConverter x:Key="notificationSeverityToBackgroundBrushConverter" />
        <conv:NotificationSeverityToBorderBrushConverter x:Key="notificationSeverityToBorderBrushConverter" />
        <conv:NotificationSeverityToIconConverter x:Key="notificationSeverityToIconConverter" />

    </UserControl.Resources>

    <Border
        Background="{Binding Severity, Converter={StaticResource notificationSeverityToBackgroundBrushConverter}}"
        BorderBrush="{Binding Severity, Converter={StaticResource notificationSeverityToBorderBrushConverter}}"
        BorderThickness="1"
        CornerRadius="8"
        Padding="12"
        Margin="0">

        <Grid ColumnDefinitions="Auto,*,Auto">

            <PathIcon
                Grid.Column="0"
                Data="{Binding Severity, Converter={StaticResource notificationSeverityToIconConverter}}"
                Foreground="{DynamicResource TextFillColorPrimary}"
                Height="20"
                Width="20"
                VerticalAlignment="Center"
                Margin="0 0 12 0" />

            <TextBlock
                Grid.Column="1"
                Foreground="{DynamicResource TextFillColorPrimary}"
                Text="{Binding Message}"
                TextWrapping="Wrap"
                VerticalAlignment="Center" />

            <Button
                Grid.Column="2"
                Background="Transparent"
                Command="{Binding $parent[ItemsControl].((vm:NotificationsPanelViewModel)DataContext).DismissCommand}"
                CommandParameter="{Binding}"
                Content="✕"
                FontSize="10"
                Padding="4 2"
                Margin="8 0 0 0" />

        </Grid>

    </Border>

</UserControl>
